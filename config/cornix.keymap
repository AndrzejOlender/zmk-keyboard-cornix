#include "zmk-helpers/helper.h"
#include "includes/cornix54.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

// tap windows for ctl alt and gui

#define HM_TAPPING_TERM 250
#define HM_TAPPING_REPEAT 210

// https://github.com/manna-harbour/miryoku_zmk - miryoku_behaviors.dtsi/.h, miryoku.h:26
#define U_TAPPING_TERM 200
#define BASE 0
#define WIN 1
#define LOWER 2
#define RAISE 3
#define NAVI   4
#define MEDIA  5
#define DEBUG  6
#define ZMK_POINTING_DEFAULT_SCRL_VAL 15

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        // https://github.com/manna-harbour/miryoku_zmk - miryoku_behaviors.dtsi
        // Non-positional: tap/hold resolved purely by tapping-term-ms, regardless
        // of which other key is pressed meanwhile (no hold-trigger-key-positions).
        u_mt: u_mt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "tap-preferred";
            tapping-term-ms = <U_TAPPING_TERM>;
        };

        /*
         * Non-Positional Homerow Mods
         * Used for &mm_grescm_gui behavior on left hand.
         *
         * Usage: &hm LSHFT T
         * Tap: T
         * Tap-Tap-Hold: Repeat T
         * Hold: LSHIFT
         */

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
        };

        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;

            flavor = "hold-preferred";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
        };

        // Tap-preferred layer-tap (Miryoku formula) for keys pressed
        // mid-typing (Space): another key pressed during the term resolves
        // as the TAP, so fast typing never leaks the held layer.
        tp_lt: tp_lt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;

            flavor = "tap-preferred";
            tapping-term-ms = <U_TAPPING_TERM>;
            quick-tap-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ---- Reading the layer diagrams ---------------------------------------
        // Every layer below carries an ASCII map of the board, laid out the way
        // the keys actually sit under your hands. The two centre cells in the
        // third row are the encoder-click keys; the blank centre gaps in the
        // other rows are where no key exists.
        //
        //   .          unused (&none)
        //   ...        transparent - falls through to the layer below (&trans)
        //   X/Y        tap X, hold Y
        //              home row mods: G = Gui, A = Alt, C = Ctrl, S = Shift
        //   NUM SYM NPAD MOUSE MEDIA DBG        hold to reach that layer
        //   BT0 - BT4  select Bluetooth profile       BTclr  clear profile
        //   DskN       switch to macOS desktop N      BOOT   enter bootloader
        //   MB1 - MB3  mouse buttons     Ms-*  move pointer     Scr-*  scroll
        //
        // The diagrams describe the bindings underneath them - change a binding
        // and its diagram needs the same change.
        // -------------------------------------------------------------------------

        default_layer {
            display-name = "Base";

            // QWERTY alphas with GACS home row mods - pinky to index, Gui Alt
            // Ctrl Shift, mirrored on both hands. The outer left column is
            // unused. Left thumbs: Esc/Media, Tab/NPAD, Space/Mouse. Right
            // thumbs: Ent/Sym and Bksp/Num (tap = key, hold = layer).
            //
            // +-------------------------------------------------------------------------------------------------------------------------------------------+
            // |    .    |    Q    |    W    |    E    |    R    |    T    |         |         |    Y    |    U    |    I    |    O    |    P    |    .    |
            // |    .    |   A/G   |   S/A   |   D/C   |   F/S   |    G    |         |         |    H    |   J/S   |   K/C   |   L/A   |   '/G   |    .    |
            // |    .    |    Z    |    X    |    C    |    V    |    B    |   MUTE  |   MB3   |    N    |    M    |    ,    |    .    |    UP   |    /    |
            // |    .    |    .    |    .    |Esc/Media| Tab/NPAD|Spc/Mouse|         |         | Ent/Sym | Bksp/Num|    .    |   LEFT  |   DOWN  |   RGHT  |
            // +-------------------------------------------------------------------------------------------------------------------------------------------+
            bindings = <
&none      &kp Q          &kp W          &kp E          &kp R                  &kp T                            &kp Y      &kp U                &kp I          &kp O          &kp P            &none
&none      &u_mt LGUI A   &u_mt LALT S   &u_mt LCTRL D  &u_mt LSHFT F          &kp G                            &kp H      &u_mt RSHFT J        &u_mt RCTRL K  &u_mt RALT L   &u_mt RGUI SQT  &none
&none      &kp Z          &kp X          &kp C          &kp V                  &kp B          &kp C_MUTE  &mkp MB3  &kp N      &kp M                &kp COMMA      &kp DOT        &kp UP           &kp FSLH
&none      &none          &none          &lt 5 ESCAPE   &lt 3 TAB              &tp_lt 4 SPACE                   &tp_lt 2 ENTER   &tp_lt 1 BACKSPACE  &none          &kp LEFT       &kp DOWN         &kp RIGHT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        win_layer {
            display-name = "Numbers";

            // Miryoku-style number layer: a numpad block under the left hand,
            // with ` ; = \ on the free slots and Dot, Minus, 0 on the left
            // thumb keys. The right hand stays transparent, so the right home
            // row mods still work. Activated by holding Backspace (tap = Bksp).
            //
            // +-------------------------------------------------------------------------------------------------------------------------------------------+
            // |    .    |    [    |    7    |    8    |    9    |    ]    |         |         |    .    |    .    |    .    |    .    |    .    |    .    |
            // |    .    |    ;    |    4    |    5    |    6    |    =    |         |         |   ...   |   ...   |   ...   |   ...   |   ...   |   ...   |
            // |    .    |    `    |    1    |    2    |    3    |    \    |   MUTE  |   MB3   |   ...   |   ...   |   ...   |   ...   |   ...   |   ...   |
            // |    .    |    .    |    .    |   Dot   |    -    |    0    |         |         |   ...   |   ...   |   ...   |   ...   |   ...   |   ...   |
            // +-------------------------------------------------------------------------------------------------------------------------------------------+
            bindings = <
&none  &kp LBKT   &kp N7   &kp N8   &kp N9   &kp RBKT                      &none  &none  &none  &none  &none  &none
&kp SEMI    &kp N4   &kp N5   &kp N6   &kp EQUAL &none                       &trans &trans &trans &trans &trans &trans
&kp GRAVE   &kp N1   &kp N2   &kp N3   &kp BSLH  &none      &kp C_MUTE  &mkp MB3  &trans &trans &trans &trans &trans &trans
&none       &none    &none    &kp DOT  &kp MINUS &kp N0                       &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Symbol_layer {
            display-name = "Symbols";

            // Miryoku-style symbol layer - the same numpad geometry as
            // Numbers, with the shifted symbols. The right hand stays
            // transparent, so the right home row mods still work. Activated
            // by holding Enter (tap = Enter). The left outer column keeps
            // the BT profiles.
            //
            // +-------------------------------------------------------------------------------------------------------------------------------------------+
            // |    .    |    {    |    &    |    *    |    (    |    }    |         |         |    .    |    .    |    .    |    .    |    .    |    .    |
            // |   BT0   |    :    |    $    |    %    |    ^    |    +    |         |         |   ...   |   ...   |   ...   |   ...   |   ...   |   ...   |
            // |   BT1   |    ~    |    !    |    @    |    #    |    |    |   MUTE  |   MB3   |   ...   |   ...   |   ...   |   ...   |   ...   |   ...   |
            // |   BT2   |    .    |    .    |    (    |    _    |    )    |         |         |   ...   |   ...   |   ...   |   ...   |   ...   |   ...   |
            // +-------------------------------------------------------------------------------------------------------------------------------------------+
            bindings = <
&none        &kp LBRC   &kp AMPS   &kp ASTRK  &kp LPAR   &kp RBRC                      &none  &none  &none  &none  &none  &none
&bt BT_SEL 0 &kp COLON  &kp DLLR   &kp PRCNT  &kp CARET  &kp PLUS                      &trans &trans &trans &trans &trans &trans
&bt BT_SEL 1 &kp TILDE  &kp EXCL   &kp AT     &kp HASH   &kp PIPE   &kp C_MUTE  &mkp MB3  &trans &trans &trans &trans &trans &trans
&bt BT_SEL 2 &none       &none      &kp LPAR   &kp UNDER  &kp RPAR                     &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Mix_layer {
            display-name = "Numpad+BT";

            // Only the macOS desktop switches - Cmd+Opt+1..4 on Q/W/E/R, the
            // Mission Control shortcuts - plus the thumb keys, so Esc, Space and
            // Enter keep working while NPAD is held. Everything else is unused.
            //
            // +-------------------------------------------------------------------------------------------------------------------------------------------+
            // |    .    |   Dsk1  |   Dsk2  |   Dsk3  |   Dsk4  |    .    |         |         |    .    |    .    |    .    |    .    |    .    |    .    |
            // |    .    |    .    |    .    |    .    |    .    |    .    |         |         |    .    |    .    |    .    |    .    |    .    |    .    |
            // |    .    |    .    |    .    |    .    |    .    |    .    |   MUTE  |   MB3   |    .    |    .    |    .    |    .    |    .    |    .    |
            // |    .    |    .    |    .    |   ESC   |    .    |  SPACE  |         |         |   ENT   |    .    |    .    |    .    |    .    |    .    |
            // +-------------------------------------------------------------------------------------------------------------------------------------------+
            bindings = <
&none  &kp LA(LG(N1))  &kp LA(LG(N2))  &kp LA(LG(N3))  &kp LA(LG(N4))  &none                       &none  &none  &none  &none  &none  &none
&none  &none           &none           &none           &none           &none                       &none  &none  &none  &none  &none  &none
&none  &none           &none           &none           &none           &none     &kp C_MUTE  &mkp MB3  &none  &none  &none  &none  &none  &none
&none  &none           &none           &kp ESCAPE      &none           &kp SPACE                   &kp ENTER  &none  &none  &none  &none  &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Navi_layer {
            display-name = "Navi";

            // Pointer movement and scrolling on the left hand, mouse buttons
            // (left, right, middle) on the right-hand top row.
            // Activated by holding Space on Base.
            //
            // +-------------------------------------------------------------------------------------------------------------------------------------------+
            // |    .    |    .    |    .    |   Ms-u  |    .    |    .    |         |         |   MB1   |   MB2   |   MB3   |  Scr-u  |  Scr-d  |    .    |
            // |    .    |    .    |   Ms-l  |   Ms-d  |   Ms-r  |  Scr-u  |         |         |    .    |    .    |    .    |    .    |    .    |    .    |
            // |    .    |    .    |    .    |    .    |    .    |  Scr-d  |   ...   |   ...   |   ...   |   ...   |    .    |    .    |    .    |    .    |
            // |    .    |    .    |    .    |   DBG   |   ...   |   ...   |         |         |    .    |    .    |    .    |    .    |    .    |    .    |
            // +-------------------------------------------------------------------------------------------------------------------------------------------+
            bindings = <
&none  &none  &none           &mmv MOVE_UP    &none         &none                   &mkp MB1  &mkp MB2  &mkp MB3  &msc SCRL_UP  &msc SCRL_DOWN  &none
&none  &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_UP                    &none  &none  &none    &none     &none           &none
&none  &none  &none           &none           &none            &msc SCRL_DOWN  &trans  &trans  &trans    &trans    &none     &none         &none           &none
&none  &none  &none           &mo 6           &trans           &trans                          &none     &none     &none      &none         &none           &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Media_layer {
            display-name = "Media";

            // Media control in the Miryoku style: the keys mirror the arrow
            // positions on Base, and Play/Stop/Mute sit on the right thumb keys.
            // The left hand stays transparent for typing and modifiers.
            // Activated by holding Esc on Base (tap stays Esc).
            //
            // +-------------------------------------------------------------------------------------------------------------------------------------------+
            // |   ...   |   ...   |   ...   |   ...   |   ...   |   ...   |         |         |   ...   |   ...   |   ...   |   ...   |   ...   |   ...   |
            // |   ...   |   ...   |   ...   |   ...   |   ...   |   ...   |         |         |   ...   |   ...   |   ...   |   ...   |   ...   |   ...   |
            // |   ...   |   ...   |   ...   |   ...   |   ...   |   ...   |   ...   |   ...   |   ...   |   ...   |   ...   |   ...   |  Vol+   |   ...   |
            // |   ...   |   ...   |   ...   |   ...   |   ...   |   ...   |         |         |  Play   |  Stop   |  Mute   |  Prev   |  Vol-   |  Next   |
            // +-------------------------------------------------------------------------------------------------------------------------------------------+
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans  &trans  &kp C_VOLUME_UP  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &kp C_PLAY_PAUSE  &kp C_STOP  &kp C_MUTE  &kp C_PREV  &kp C_VOLUME_DOWN  &kp C_NEXT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Debug_layer {
            display-name = "Debug";

            // Bluetooth profile management on the top row, and bootloader entry on
            // both halves - the outer key of each hand's bottom row.
            //
            // Reached via NAVI: hold Space, then hold the left-bottom DBG key.
            // Double-tapping the physical reset button is the reliable way
            // into the bootloader.
            //
            // +-------------------------------------------------------------------------------------------------------------------------------------------+
            // |  BTclr  |   BT0   |   BT1   |   BT2   |   BT3   |   BT4   |         |         |    .    |    .    |    .    |    .    |    .    |    .    |
            // |    .    |    .    |    .    |    .    |    .    |    .    |         |         |    .    |    .    |    .    |    .    |    .    |    .    |
            // |    .    |    .    |    .    |    .    |    .    |   BOOT  |   ...   |   ...   |   BOOT  |    .    |    .    |    .    |    .    |    .    |
            // |    .    |    .    |    .    |    .    |    .    |    .    |         |         |    .    |    .    |    .    |    .    |    .    |    .    |
            // +-------------------------------------------------------------------------------------------------------------------------------------------+
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &none        &none  &none   &none  &none  &none
&none       &none         &none         &none         &none         &none                         &none        &none  &none   &none  &none  &none
&none       &none         &none         &none         &none         &bootloader   &trans  &trans  &bootloader  &none  &none   &none  &none  &none
&none       &none         &none         &none         &none         &none                         &none        &none  &none  &none  &none  &none
            >;
        };
    };
};
