#include "zmk-helpers/helper.h"
#include "includes/cornix54.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

// tap windows for ctl alt and gui

#define HM_TAPPING_TERM 250
#define HM_TAPPING_REPEAT 210

// https://github.com/manna-harbour/miryoku_zmk - miryoku_behaviors.dtsi/.h, miryoku.h:26
#define U_TAPPING_TERM 200
#define BASE 0
#define WIN 1
#define LOWER 2
#define RAISE 3
#define ADJUST 4
#define NAVI   5
#define NUM    6
#define DEBUG  7
#define ZMK_POINTING_DEFAULT_SCRL_VAL 15

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        // https://github.com/manna-harbour/miryoku_zmk - miryoku_behaviors.dtsi
        // Non-positional: tap/hold resolved purely by tapping-term-ms, regardless
        // of which other key is pressed meanwhile (no hold-trigger-key-positions).
        u_mt: u_mt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "tap-preferred";
            tapping-term-ms = <U_TAPPING_TERM>;
        };

        /*
         * Non-Positional Homerow Mods
         * Used for &mm_grescm_gui behavior on left hand.
         *
         * Usage: &hm LSHFT T
         * Tap: T
         * Tap-Tap-Hold: Repeat T
         * Hold: LSHIFT
         */

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
        };

        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;

            flavor = "hold-preferred";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ---- Reading the layer diagrams ---------------------------------------
        // Every layer below carries an ASCII map of the board, laid out the way
        // the keys actually sit under your hands. The two centre cells in the
        // third row are the encoder-click keys; the blank centre gaps in the
        // other rows are where no key exists.
        //
        //   .          unused (&none)
        //   ...        transparent - falls through to the layer below (&trans)
        //   X/Y        tap X, hold Y
        //              home row mods: G = Gui, A = Alt, C = Ctrl, S = Shift
        //   NUM SYM NPAD NAV MOUSE KPAD DBG    hold to reach that layer
        //   BT0 - BT4  select Bluetooth profile       BTclr  clear profile
        //   DskN       switch to macOS desktop N      BOOT   enter bootloader
        //   MB1 - MB3  mouse buttons     Ms-*  move pointer     Scr-*  scroll
        //
        // The diagrams describe the bindings underneath them - change a binding
        // and its diagram needs the same change.
        // -------------------------------------------------------------------------

        default_layer {
            display-name = "Base";

            // QWERTY alphas with GACS home row mods - pinky to index, Gui Alt
            // Ctrl Shift, mirrored on both hands. The left thumb reaches NUM and
            // NPAD, the right thumb SYM, and the left Alt key doubles as NAV.
            //
            // +-------------------------------------------------------------------------------------------------------------------------------------------+
            // |   TAB   |    Q    |    W    |    E    |    R    |    T    |         |         |    Y    |    U    |    I    |    O    |    P    |   BSPC  |
            // |   LCTL  |   A/G   |   S/A   |   D/C   |   F/S   |    G    |         |         |    H    |   J/S   |   K/C   |   L/A   |   \/G   |   ENT   |
            // |   LSFT  |    Z    |    X    |    C    |    V    |    B    |   MUTE  |   MB3   |    N    |    M    |    ,    |    .    |    UP   |    /    |
            // |   LCTL  | Alt/NAV |   NUM   |   ESC   |   NPAD  |  SPACE  |         |         |   ENT   |   BSPC  |   SYM   |   LEFT  |   DOWN  |   RGHT  |
            // +-------------------------------------------------------------------------------------------------------------------------------------------+
            bindings = <
&kp TAB    &kp Q          &kp W          &kp E          &kp R                  &kp T                            &kp Y      &kp U                &kp I          &kp O          &kp P            &kp BACKSPACE
&kp LCTRL  &u_mt LGUI A   &u_mt LALT S   &u_mt LCTRL D  &u_mt LSHFT F          &kp G                            &kp H      &u_mt RSHFT J        &u_mt RCTRL K  &u_mt RALT L   &u_mt RGUI BSLH  &kp ENTER
&kp LSHFT  &kp Z          &kp X          &kp C          &kp V                  &kp B          &kp C_MUTE  &mkp MB3  &kp N      &kp M                &kp COMMA      &kp DOT        &kp UP           &kp FSLH
&kp LCTRL  &lt 4 LALT     &mo 1          &kp ESCAPE     &mo 3                  &kp SPACE                        &kp ENTER  &kp BACKSPACE        &mo 2          &kp LEFT       &kp DOWN         &kp RIGHT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        win_layer {
            display-name = "Numbers";

            // The number row along the top, with the punctuation that pairs with
            // it on the home row below. Home row mods stay transparent here.
            //
            // +-------------------------------------------------------------------------------------------------------------------------------------------+
            // |   ESC   |    1    |    2    |    3    |    4    |    5    |         |         |    6    |    7    |    8    |    9    |    0    |   DEL   |
            // |    ~    |   ...   |   ...   |   ...   |    ;    |    -    |         |         |    =    |    '    |   ...   |   ...   |   ...   |    .    |
            // |    .    |    .    |    .    |    .    |    .    |    .    |   MUTE  |   MB3   |    .    |    .    |    .    |    .    |    .    |    .    |
            // |    .    |    .    |    .    |   ESC   |    .    |  SPACE  |         |         |   ENT   |    .    |    .    |    .    |    .    |    .    |
            // +-------------------------------------------------------------------------------------------------------------------------------------------+
            bindings = <
&kp ESCAPE  &kp N1   &kp N2   &kp N3   &kp N4    &kp N5                    &kp N6     &kp N7   &kp N8   &kp N9   &kp N0   &kp DEL
&kp TILDE   &trans   &trans   &trans   &kp SEMI  &kp MINUS                 &kp EQUAL  &kp SQT  &trans   &trans   &trans   &none
&none       &none    &none    &none    &none     &none      &kp C_MUTE  &mkp MB3  &none      &none    &none    &none    &none    &none
&none       &none    &none    &kp ESCAPE &none    &kp SPACE                 &kp ENTER  &none    &none    &none    &none    &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Symbol_layer {
            display-name = "Symbols";

            // The shifted number row plus brackets and quotes. The left outer
            // column - the keys legended Caps/Shift/Ctrl - selects a Bluetooth
            // profile, matching their green secondary legends.
            //
            // +-------------------------------------------------------------------------------------------------------------------------------------------+
            // |    .    |    !    |    @    |    #    |    $    |    %    |         |         |    ^    |    &    |    *    |    (    |    )    |   PgUp  |
            // |   BT0   |   ...   |   ...   |   ...   |   ...   |    .    |         |         |    +    |    "    |   ...   |    :    |    "    |   PgDn  |
            // |   BT1   |    .    |    .    |    .    |    .    |    .    |   MUTE  |   MB3   |    [    |    ]    |    .    |    .    |    .    |    .    |
            // |   BT2   |    .    |    .    |    .    |    .    |  SPACE  |         |         |   ENT   |    .    |    .    |    .    |    .    |    .    |
            // +-------------------------------------------------------------------------------------------------------------------------------------------+
            bindings = <
&none               &kp EXCL  &kp AT   &kp HASH  &kp DLLR  &kp PRCNT                 &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR  &kp PAGE_UP
&bt BT_SEL 0         &trans    &trans   &trans    &trans    &none                     &kp PLUS   &kp DQT   &trans     &kp COLON &kp DQT   &kp PAGE_DOWN
&bt BT_SEL 1         &none     &none    &none     &none     &none      &kp C_MUTE  &mkp MB3  &kp LBKT   &kp RBKT  &none      &none     &none     &none
&bt BT_SEL 2         &none     &none    &none     &none     &kp SPACE                 &kp ENTER  &none     &none      &none     &none     &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Mix_layer {
            display-name = "Numpad+BT";

            // Numpad under the left hand, symbols under the right. Q/W/E/R switch
            // macOS desktops via Cmd+Opt+1..4, the Mission Control shortcuts -
            // there are four desktops, so T is deliberately unused. The left outer
            // column selects a Bluetooth profile, as on SYM.
            //
            // +-------------------------------------------------------------------------------------------------------------------------------------------+
            // |   ESC   |   Dsk1  |   Dsk2  |   Dsk3  |   Dsk4  |    .    |         |         |    ^    |    &    |   KP*   |    (    |    )    |   KP/   |
            // |   BT0   |   KP1   |   KP2   |   KP3   |   KP4   |   KP5   |         |         |   KP-   |   KP=   |    `    |    [    |    ]    |    |    |
            // |   BT1   |   KP6   |   KP7   |   KP8   |   KP9   |   KP0   |   MUTE  |   MB3   |    _    |   KP+   |    ~    |    {    |    }    |    .    |
            // |   BT2   |    .    |    .    |   ESC   |    .    |  SPACE  |         |         |   ENT   |    .    |    .    |    .    |    .    |    .    |
            // +-------------------------------------------------------------------------------------------------------------------------------------------+
            bindings = <
&kp ESCAPE           &kp LA(LG(N1))     &kp LA(LG(N2))     &kp LA(LG(N3))     &kp LA(LG(N4))     &none                       &kp CARET     &kp AMPS      &kp KP_MULTIPLY  &kp LPAR   &kp RPAR   &kp KP_DIVIDE
&bt BT_SEL 0         &kp KP_N1          &kp KP_N2          &kp KP_N3          &kp KP_N4          &kp KP_N5                   &kp KP_MINUS  &kp KP_EQUAL  &kp GRAVE        &kp LBKT   &kp RBKT   &kp PIPE
&bt BT_SEL 1         &kp KP_N6          &kp KP_N7          &kp KP_N8          &kp KP_N9          &kp KP_N0    &kp C_MUTE  &mkp MB3      &kp UNDER     &kp KP_PLUS      &kp TILDE  &kp LBRC   &kp RBRC   &none
&bt BT_SEL 2         &none              &none              &kp ESCAPE         &none              &kp SPACE                   &kp ENTER     &none         &none            &none      &none      &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Adjust_layer {
            display-name = "Nav";

            // Home/End/PgUp/PgDn in a block around the arrow keys, which stay on
            // Base and remain reachable here. Everything else is transparent, so
            // the other thumb layers still work while NAV is held.
            //
            // +-------------------------------------------------------------------------------------------------------------------------------------------+
            // |   ...   |   ...   |   ...   |   ...   |   ...   |   ...   |         |         |   ...   |   ...   |   PgUp  |   Home  |   ...   |   ...   |
            // |   ...   |   ...   |   ...   |   ...   |   ...   |   ...   |         |         |   ...   |   ...   |   ...   |   ...   |   ...   |   ...   |
            // |   ...   |   ...   |   ...   |   ...   |   ...   |   ...   |   MUTE  |   MB3   |   ...   |   ...   |   PgDn  |   End   |   ...   |   ...   |
            // |   ...   |   ...   |   ...   |   ...   |   ...   |   ...   |         |         |   ...   |   ...   |   ...   |   ...   |   ...   |   ...   |
            // +-------------------------------------------------------------------------------------------------------------------------------------------+
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans      &kp PAGE_UP  &kp HOME  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans      &trans       &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans     &kp C_MUTE  &mkp MB3  &trans      &trans       &kp PAGE_DOWN &kp END &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans      &trans       &trans    &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Navi_layer {
            display-name = "Navi";

            // Pointer movement and scrolling on the left hand, mouse buttons and
            // arrows on the right.
            //
            // No key on Base activates this layer, so it is currently dormant -
            // assign it in ZMK Studio, or add a layer key here, to use it.
            //
            // +-------------------------------------------------------------------------------------------------------------------------------------------+
            // |    .    |    .    |    .    |   Ms-u  |   PgUp  |   PgDn  |         |         |   MB1   |   MB3   |   MB2   |  Scr-u  |  Scr-d  |    .    |
            // |    .    |    .    |   Ms-l  |   Ms-d  |   Ms-r  |  Scr-u  |         |         |   LEFT  |   DOWN  |    UP   |   RGHT  |    .    |    .    |
            // |    .    |    .    |    .    |    .    |    .    |  Scr-d  |   ...   |   ...   |   ...   |   ...   |    .    |    .    |    .    |    .    |
            // |    .    |    .    |    .    |   DBG   |   ...   |   ...   |         |         |    .    |    .    |    5    |    .    |    .    |    .    |
            // +-------------------------------------------------------------------------------------------------------------------------------------------+
            bindings = <
&none  &none  &none           &mmv MOVE_UP    &kp PAGE_UP      &kp PAGE_DOWN                   &mkp MB1  &mkp MB3  &mkp MB2  &msc SCRL_UP  &msc SCRL_DOWN  &none
&none  &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_UP                    &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT     &none           &none
&none  &none  &none           &none           &none            &msc SCRL_DOWN  &trans  &trans  &trans    &trans    &none     &none         &none           &none
&none  &none  &none           &mo 7           &trans           &trans                          &none     &none     &kp N5    &none         &none           &none
            >;
        };

        KeyPad_layer {
            display-name = "NumPad";

            // A standalone numpad on the right hand, in calculator arrangement.
            //
            // No key on Base activates this layer, so it is currently dormant -
            // the numpad on NPAD is the one in daily use.
            //
            // +-------------------------------------------------------------------------------------------------------------------------------------------+
            // |   DBG   |    .    |    .    |    .    |    .    |    .    |         |         |   KP7   |   KP8   |   KP9   |   KP-   |   KP*   |    .    |
            // |    .    |    .    |    .    |    .    |    .    |    .    |         |         |   KP4   |   KP5   |   KP6   |   KP+   |   KP/   |    .    |
            // |    .    |    .    |    .    |    .    |    .    |    .    |   ...   |   ...   |   KP1   |   KP2   |   KP3   |    .    |    .    |    .    |
            // |    .    |    .    |    .    |    .    |    .    |   DBG   |         |         |   KP0   |   KP.   |   KP0   |    .    |    .    |    .    |
            // +-------------------------------------------------------------------------------------------------------------------------------------------+
            bindings = <
&mo 7  &none  &none  &none  &none  &none                  &kp KP_N7        &kp KP_N8        &kp KP_N9        &kp KP_MINUS  &kp KP_MULTIPLY  &none
&none  &none  &none  &none  &none  &none                  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_N6        &kp KP_PLUS   &kp KP_DIVIDE    &none
&none  &none  &none  &none  &none  &none  &trans  &trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_N3        &none         &none            &none
&none  &none  &none  &none  &none  &mo 7                  &kp KP_N0        &kp KP_DOT       &kp KP_NUMBER_0  &none         &none            &none
            >;
        };

        Debug_layer {
            display-name = "Debug";

            // Bluetooth profile management on the top row, and bootloader entry on
            // both halves - the outer key of each hand's bottom row.
            //
            // Only MOUSE and KPAD activate this layer, and neither is reachable
            // from Base, so it is dormant too. Double-tapping the physical reset
            // button is the reliable way into the bootloader.
            //
            // +-------------------------------------------------------------------------------------------------------------------------------------------+
            // |  BTclr  |   BT0   |   BT1   |   BT2   |   BT3   |   BT4   |         |         |    .    |    .    |    .    |    .    |    .    |    .    |
            // |    .    |    .    |    .    |    .    |    .    |    .    |         |         |    .    |    .    |    .    |    .    |    .    |    .    |
            // |    .    |    .    |    .    |    .    |    .    |   BOOT  |   ...   |   ...   |   BOOT  |    .    |    .    |    .    |    .    |    .    |
            // |    .    |    .    |    .    |    .    |    .    |    .    |         |         |    .    |    .    |    7    |    .    |    .    |    .    |
            // +-------------------------------------------------------------------------------------------------------------------------------------------+
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &none        &none  &none   &none  &none  &none
&none       &none         &none         &none         &none         &none                         &none        &none  &none   &none  &none  &none
&none       &none         &none         &none         &none         &bootloader   &trans  &trans  &bootloader  &none  &none   &none  &none  &none
&none       &none         &none         &none         &none         &none                         &none        &none  &kp N7  &none  &none  &none
            >;
        };
    };
};
