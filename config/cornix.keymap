#include "zmk-helpers/helper.h"
#include "includes/cornix54.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

// tap windows for ctl alt and gui

#define HM_TAPPING_TERM 250
#define HM_TAPPING_REPEAT 210

// https://github.com/manna-harbour/miryoku_zmk - miryoku_behaviors.dtsi/.h, miryoku.h:26
#define U_TAPPING_TERM 200
#define BASE 0
#define WIN 1
#define LOWER 2
#define RAISE 3
#define ADJUST 4
#define NAVI   5
#define NUM    6
#define DEBUG  7
#define ZMK_POINTING_DEFAULT_SCRL_VAL 15

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        // https://github.com/manna-harbour/miryoku_zmk - miryoku_behaviors.dtsi
        // Non-positional: tap/hold resolved purely by tapping-term-ms, regardless
        // of which other key is pressed meanwhile (no hold-trigger-key-positions).
        u_mt: u_mt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "tap-preferred";
            tapping-term-ms = <U_TAPPING_TERM>;
        };

        /*
         * Non-Positional Homerow Mods
         * Used for &mm_grescm_gui behavior on left hand.
         *
         * Usage: &hm LSHFT T
         * Tap: T
         * Tap-Tap-Hold: Repeat T
         * Hold: LSHIFT
         */

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
        };

        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;

            flavor = "hold-preferred";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ---- ASCII legend for the per-layer diagrams below --------------------
        // .        = &none (unused)     ...  = &trans (falls through to the layer below)
        // X/g,a,c,s = home row mod-tap via u_mt: tap X, hold Gui/Alt/Ctrl/Shift
        // NUM/SYM/BT/NAV = &mo or &lt into the layer of that display-name
        // Dbg = &mo 7 (Debug)   BTn = &bt BT_SEL n   BOOT = &bootloader
        // U00?/U01?/U02?/0x1e?-0x21? = USER00-02 / raw hex codes, meaning unknown
        //   (ported as-is from keyboard.vil - see CLAUDE.md there)
        // Diagrams read left-to-right as physically typed; the 2-cell gap in row 3
        // is the encoder-click pair (MUTE, MB3) present on every layer.
        // -------------------------------------------------------------------------

        default_layer {
            display-name = "Base";

            // Ported from keyboard.vil layer 0 (GACS home row mods + Nav layer-tap).
            // Flat position map (see config/includes/cornix54.h + config/cornix.json):
            //   0-5 top-L | 6-11 top-R | 12-17 home-L | 18-23 home-R
            //   24-29 bottom-L | 30 LH3(gap) | 31 RH3(gap) | 32-37 bottom-R
            //   38-43 thumb/palm-L | 44-49 thumb/palm-R
            //
            // +---------------------------------------------------------------------------------------------------------------+
            // |  TAB  |   Q   |   W   |   E   |   R   |   T   |       |       |   Y   |   U   |   I   |   O   |   P   |  BSPC |
            // |  LCTL |  A/g  |  S/a  |  D/c  |  F/s  |   G   |       |       |   H   |  J/s  |  K/c  |  L/a  |  \/g  |  ENT  |
            // |  LSFT |   Z   |   X   |   C   |   V   |   B   |  MUTE |  MB3  |   N   |   M   |   ,   |   .   |   UP  |   /   |
            // |  LCTL |Alt/NAV|  NUM  |  ESC  |   BT  | SPACE |       |       |  ENT  |  BSPC |  SYM  |  LEFT |  DOWN |  RGHT |
            // +---------------------------------------------------------------------------------------------------------------+
            bindings = <
&kp TAB    &kp Q          &kp W          &kp E          &kp R                  &kp T                            &kp Y      &kp U                &kp I          &kp O          &kp P            &kp BACKSPACE
&kp LCTRL  &u_mt LGUI A   &u_mt LALT S   &u_mt LCTRL D  &u_mt LSHFT F          &kp G                            &kp H      &u_mt RSHFT J        &u_mt RCTRL K  &u_mt RALT L   &u_mt RGUI BSLH  &kp ENTER
&kp LSHFT  &kp Z          &kp X          &kp C          &kp V                  &kp B          &kp C_MUTE  &mkp MB3  &kp N      &kp M                &kp COMMA      &kp DOT        &kp UP           &kp FSLH
&kp LCTRL  &lt 4 LALT     &mo 1          &kp ESCAPE     &mo 3                  &kp SPACE                        &kp ENTER  &kp BACKSPACE        &mo 2          &kp LEFT       &kp DOWN         &kp RIGHT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        win_layer {
            display-name = "Numbers";

            // Ported from keyboard.vil layer 1 (MO(1), numbers + top punctuation).
            // Q/W/E/R/T restored to stock macOS virtual-desktop switching
            // (Opt+Cmd+1..5, confirmed from the Mission Control keyboard shortcuts
            // settings) instead of the 1-5 that lived here in vil - that numbering
            // was already a pre-ZMK drift from stock, not something this port
            // introduced. Dsk5 (T) is an extrapolation of the 1-4 pattern actually
            // seen in Settings; verify it once flashed.
            //
            // +---------------------------------------------------------------------------------------------------------------+
            // |  ESC  |  Dsk1 |  Dsk2 |  Dsk3 |  Dsk4 |  Dsk5 |       |       |   6   |   7   |   8   |   9   |   0   |  DEL  |
            // |   ~   |  ...  |  ...  |  ...  |   ;   |   -   |       |       |   =   |   '   |  ...  |  ...  |  ...  |   .   |
            // |   .   |   .   |   .   |   .   |   .   |   .   |  MUTE |  MB3  |   .   |   .   |   .   |   .   |   .   |   .   |
            // |   .   |   .   |   .   |  ESC  |   .   | SPACE |       |       |  ENT  |   .   |   .   |   .   |   .   |   .   |
            // +---------------------------------------------------------------------------------------------------------------+
            bindings = <
&kp ESCAPE  &kp LA(LG(N1))  &kp LA(LG(N2))  &kp LA(LG(N3))  &kp LA(LG(N4))  &kp LA(LG(N5))                    &kp N6     &kp N7   &kp N8   &kp N9   &kp N0   &kp DEL
&kp TILDE   &trans   &trans   &trans   &kp SEMI  &kp MINUS                 &kp EQUAL  &kp SQT  &trans   &trans   &trans   &none
&none       &none    &none    &none    &none     &none      &kp C_MUTE  &mkp MB3  &none      &none    &none    &none    &none    &none
&none       &none    &none    &kp ESCAPE &none    &kp SPACE                 &kp ENTER  &none    &none    &none    &none    &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Symbol_layer {
            display-name = "Symbols";

            // Ported from keyboard.vil layer 2 (MO(2), shifted-number symbols + brackets).
            // USER00/USER01/USER02 (flat 12/24/38, the Caps/Shift/Ctrl-labeled outer
            // column) = hold this layer + tap = BT profile select, confirmed from the
            // stock keycaps' green secondary legends (was "meaning unknown" in vil).
            //
            // +---------------------------------------------------------------------------------------------------------------+
            // |   .   |   !   |   @   |   #   |   $   |   %   |       |       |   ^   |   &   |   *   |   (   |   )   |  PgUp |
            // |  BT0  |  ...  |  ...  |  ...  |  ...  |   .   |       |       |   +   |   "   |  ...  |   :   |   "   |  PgDn |
            // |  BT1  |   .   |   .   |   .   |   .   |   .   |  MUTE |  MB3  |   [   |   ]   |   .   |   .   |   .   |   .   |
            // |  BT2  |   .   |   .   |   .   |   .   | SPACE |       |       |  ENT  |   .   |   .   |   .   |   .   |   .   |
            // +---------------------------------------------------------------------------------------------------------------+
            bindings = <
&none               &kp EXCL  &kp AT   &kp HASH  &kp DLLR  &kp PRCNT                 &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR  &kp PAGE_UP
&bt BT_SEL 0         &trans    &trans   &trans    &trans    &none                     &kp PLUS   &kp DQT   &trans     &kp COLON &kp DQT   &kp PAGE_DOWN
&bt BT_SEL 1         &none     &none    &none     &none     &none      &kp C_MUTE  &mkp MB3  &kp LBKT   &kp RBKT  &none      &none     &none     &none
&bt BT_SEL 2         &none     &none    &none     &none     &kp SPACE                 &kp ENTER  &none     &none      &none     &none     &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Mix_layer {
            display-name = "Numpad+BT";

            // Ported from keyboard.vil layer 3 (MO(3), numpad + symbols).
            // vil has no BT keys (came from a wired board); BT_CLR/extra BT_SEL 3/4
            // added in the thumb row, since a wireless board needs some way to
            // switch/clear profiles without reflashing.
            // USER00/USER01/USER02 (flat 12/24/38) = the same BT profile select as
            // on Symbol_layer (confirmed from stock keycaps) - kept here too since
            // vil had them on both Raise and Numpad. 0xc1e-0xc21 (flat 1-4) still
            // unknown, left as &none.
            //
            // +---------------------------------------------------------------------------------------------------------------+
            // |  ESC  | 0x1e? | 0x1f? | 0x20? | 0x21? |   .   |       |       |   ^   |   &   |  KP*  |   (   |   )   |  KP/  |
            // |  BT0  |  KP1  |  KP2  |  KP3  |  KP4  |  KP5  |       |       |  KP-  |  KP=  |   `   |   [   |   ]   |   |   |
            // |  BT1  |  KP6  |  KP7  |  KP8  |  KP9  |  KP0  |  MUTE |  MB3  |   _   |  KP+  |   ~   |   {   |   }   |   .   |
            // |  BT2  | BTclr |  BT0  |  ESC  |  BT1  | SPACE |       |       |  ENT  |  BT2  |  BT3  |  BT4  |   .   |   .   |
            // +---------------------------------------------------------------------------------------------------------------+
            bindings = <
&kp ESCAPE           &none /* 0xc1e */  &none /* 0xc1f */  &none /* 0xc20 */  &none /* 0xc21 */  &none                       &kp CARET     &kp AMPS      &kp KP_MULTIPLY  &kp LPAR   &kp RPAR   &kp KP_DIVIDE
&bt BT_SEL 0         &kp KP_N1          &kp KP_N2          &kp KP_N3          &kp KP_N4          &kp KP_N5                   &kp KP_MINUS  &kp KP_EQUAL  &kp GRAVE        &kp LBKT   &kp RBKT   &kp PIPE
&bt BT_SEL 1         &kp KP_N6          &kp KP_N7          &kp KP_N8          &kp KP_N9          &kp KP_N0    &kp C_MUTE  &mkp MB3      &kp UNDER     &kp KP_PLUS      &kp TILDE  &kp LBRC   &kp RBRC   &none
&bt BT_SEL 2         &bt BT_CLR         &bt BT_SEL 0       &kp ESCAPE         &bt BT_SEL 1       &kp SPACE                   &kp ENTER     &bt BT_SEL 2  &bt BT_SEL 3     &bt BT_SEL 4  &none   &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Adjust_layer {
            display-name = "Nav";

            // Ported from keyboard.vil layer 4 (LT(4,ALT), mostly-transparent Nav layer
            // adding Home/End/PgUp/PgDn around the arrow keys that already live on Base).
            //
            // +---------------------------------------------------------------------------------------------------------------+
            // |  ...  |  ...  |  ...  |  ...  |  ...  |  ...  |       |       |  ...  |  ...  |  PgUp |  Home |  ...  |  ...  |
            // |  ...  |  ...  |  ...  |  ...  |  ...  |  ...  |       |       |  ...  |  ...  |  ...  |  ...  |  ...  |  ...  |
            // |  ...  |  ...  |  ...  |  ...  |  ...  |  ...  |  MUTE |  MB3  |  ...  |  ...  |  PgDn |  End  |  ...  |  ...  |
            // |  ...  |  ...  |  ...  |  ...  |  ...  |  ...  |       |       |  ...  |  ...  |  ...  |  ...  |  ...  |  ...  |
            // +---------------------------------------------------------------------------------------------------------------+
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans      &kp PAGE_UP  &kp HOME  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans      &trans       &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans     &kp C_MUTE  &mkp MB3  &trans      &trans       &kp PAGE_DOWN &kp END &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans      &trans       &trans    &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Navi_layer {
            display-name = "Navi";

            // Stock layer, untouched by the keyboard.vil port - mouse movement/
            // click/scroll despite the "Navi" name, plus arrow keys and mo 7 (Debug).
            //
            // +---------------------------------------------------------------------------------------------------------------+
            // |   .   |   .   |   .   |  M-up |  PgUp |  PgDn |       |       | Clk-L | Clk-M | Clk-R | Scr-u | Scr-d |   .   |
            // |   .   |   .   |  M-lt |  M-dn |  M-rt | Scr-u |       |       |  LEFT |  DOWN |   UP  |  RGHT |   .   |   .   |
            // |   .   |   .   |   .   |   .   |   .   | Scr-d |  ...  |  ...  |  ...  |  ...  |   .   |   .   |   .   |   .   |
            // |   .   |   .   |   .   |  Dbg  |  ...  |  ...  |       |       |   .   |   .   |   5   |   .   |   .   |   .   |
            // +---------------------------------------------------------------------------------------------------------------+
            bindings = <
&none  &none  &none           &mmv MOVE_UP    &kp PAGE_UP      &kp PAGE_DOWN                   &mkp MB1  &mkp MB3  &mkp MB2  &msc SCRL_UP  &msc SCRL_DOWN  &none
&none  &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_UP                    &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT     &none           &none
&none  &none  &none           &none           &none            &msc SCRL_DOWN  &trans  &trans  &trans    &trans    &none     &none         &none           &none
&none  &none  &none           &mo 7           &trans           &trans                          &none     &none     &kp N5    &none         &none           &none
            >;
        };

        KeyPad_layer {
            display-name = "NumPad";

            // Stock layer, untouched by the keyboard.vil port.
            //
            // +---------------------------------------------------------------------------------------------------------------+
            // |  Dbg  |   .   |   .   |   .   |   .   |   .   |       |       |  KP7  |  KP8  |  KP9  |  KP-  |  KP*  |   .   |
            // |   .   |   .   |   .   |   .   |   .   |   .   |       |       |  KP4  |  KP5  |  KP6  |  KP+  |  KP/  |   .   |
            // |   .   |   .   |   .   |   .   |   .   |   .   |  ...  |  ...  |  KP1  |  KP2  |  KP3  |   .   |   .   |   .   |
            // |   .   |   .   |   .   |   .   |   .   |  Dbg  |       |       |  KP0  |  KP.  |  KP0  |   .   |   .   |   .   |
            // +---------------------------------------------------------------------------------------------------------------+
            bindings = <
&mo 7  &none  &none  &none  &none  &none                  &kp KP_N7        &kp KP_N8        &kp KP_N9        &kp KP_MINUS  &kp KP_MULTIPLY  &none
&none  &none  &none  &none  &none  &none                  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_N6        &kp KP_PLUS   &kp KP_DIVIDE    &none
&none  &none  &none  &none  &none  &none  &trans  &trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_N3        &none         &none            &none
&none  &none  &none  &none  &none  &mo 7                  &kp KP_N0        &kp KP_DOT       &kp KP_NUMBER_0  &none         &none            &none
            >;
        };

        Debug_layer {
            display-name = "Debug";

            // Stock layer, untouched by the keyboard.vil port.
            //
            // +---------------------------------------------------------------------------------------------------------------+
            // | BTclr |  BT0  |  BT1  |  BT2  |  BT3  |  BT4  |       |       |   .   |   .   |   .   |   .   |   .   |   .   |
            // |   .   |   .   |   .   |   .   |   .   |   .   |       |       |   .   |   .   |   .   |   .   |   .   |   .   |
            // |   .   |   .   |   .   |   .   |   .   |  BOOT |  ...  |  ...  |  BOOT |   .   |   .   |   .   |   .   |   .   |
            // |   .   |   .   |   .   |   .   |   .   |   .   |       |       |   .   |   .   |   7   |   .   |   .   |   .   |
            // +---------------------------------------------------------------------------------------------------------------+
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &none        &none  &none   &none  &none  &none
&none       &none         &none         &none         &none         &none                         &none        &none  &none   &none  &none  &none
&none       &none         &none         &none         &none         &bootloader   &trans  &trans  &bootloader  &none  &none   &none  &none  &none
&none       &none         &none         &none         &none         &none                         &none        &none  &kp N7  &none  &none  &none
            >;
        };
    };
};
